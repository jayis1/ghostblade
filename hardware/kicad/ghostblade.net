    ;; ================================================================
    ;; ESD PROTECTION NETS
    ;; TVS diodes are connected between protected signal lines and GND.
    ;; D1 (TPD4E05U06) protects USB-C D+/D- and VBUS.
    ;; D2-D4 (BGS8N4) protect RF antenna paths (SMA_ANT0, SMA_ANT1, u.FL).
    ;; D5 (PRTR5V0U2X) protects the NFC 13.56 MHz antenna interface.
    ;; D6 (TPD4E05U06) protects microSD data/CMD lines.
    ;; D7 (TPD4E05U06) protects MIPI-CSI-2 camera data/CLK lines.
    ;; D8 (TPD4E05U06) protects HDMI 2.1 TMDS pairs.
    ;; All TVS ground pins connect to GND net (code 110).
    ;; ================================================================

    ;; ================================================================
    ;; TEST POINT NETS
    ;; TP1-TP4: Debug UART (TX, RX, GND, 3V3) — connected to existing nets
    ;; TP5-TP8: SPI bridge (SCK, MOSI, MISO, CS) — connected to nets 1-4
    ;; TP9-TP12: Power rails and INT_REQ — connected to existing nets
    ;; Test points are passive copper pads with no active components.
    ;; ================================================================

    ;; Debug UART test point connections
    (net (code "160") (name "NET_DEBUG_UART_TX")
      (node (ref "U1") (pin "AD5") (pinfunction "UART0_TX"))
      (node (ref "TP1") (pin "1"))
    )
    (net (code "161") (name "NET_DEBUG_UART_RX")
      (node (ref "U1") (pin "AD6") (pinfunction "UART0_RX"))
      (node (ref "TP2") (pin "1"))
    )

    ;; Test point connections to existing nets
    ;; TP3 (GND) connects to net code 110 (GND)
    ;; TP4 (VDD_3V3) connects to net code 103 (VDD_3V3)
    ;; TP5 (SPI_SCK) connects to net code 1 (NET_SPI_CLK)
    ;; TP6 (SPI_MOSI) connects to net code 2 (NET_SPI_MOSI)
    ;; TP7 (SPI_MISO) connects to net code 3 (NET_SPI_MISO)
    ;; TP8 (SPI_CS) connects to net code 4 (NET_SPI_CS)
    ;; TP9 (VBAT) connects to net code 108 (VBAT)
    ;; TP10 (VDD_1V8) connects to net code 104 (VDD_1V8)
    ;; TP11 (SDR_1V2) connects to net code 105 (SDR_1V2)
    ;; TP12 (INT_REQ) connects to net code 5 (NET_INT_REQ)

